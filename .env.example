# === 環境変数の雛形（このファイルはコミットされます／実キーは書かない） ===
# 使い方: このファイルを `.env` にコピーし、各値を実際のキーに置き換える。
#   cp .env.example .env
# `.env` は .gitignore 済みでコミットされません。
# プロジェクトで新しい環境変数を使うときは、ここに「どのプロジェクトが・何に使うか」をコメントして追記する。

# Anthropic API キー（LLM を使うプロジェクト共通。任意）。
ANTHROPIC_API_KEY=

# Gemini API キー（LLM を使うプロジェクト共通。任意）。
GEMINI_API_KEY=

# Discord 通知の Webhook URL（任意。未設定なら通知はスキップする実装にする）。
DISCORD_WEBHOOK_URL=
